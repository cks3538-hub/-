{
  "$defs": {
    "CadSnapshotRow": {
      "additionalProperties": false,
      "description": "CSV 유래이므로 LaxModel (문자열 -> 숫자 허용) 이지만 extra 는 금지.",
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "configuration_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Id"
        },
        "occurrence_path": {
          "title": "Occurrence Path",
          "type": "string"
        },
        "reference_id": {
          "title": "Reference Id",
          "type": "string"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "material_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Id"
        },
        "density_kg_m3": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Density Kg M3"
        },
        "volume_m3": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume M3"
        },
        "mass_kg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mass Kg"
        },
        "parameter_map": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Parameter Map",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "geometry_status": {
          "default": "solid",
          "enum": [
            "solid",
            "surface",
            "unloaded",
            "suppressed",
            "missing"
          ],
          "title": "Geometry Status",
          "type": "string"
        },
        "surface_thickness_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface Thickness M"
        },
        "is_assembly": {
          "default": false,
          "title": "Is Assembly",
          "type": "boolean"
        },
        "parent_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Path"
        },
        "source_hash": {
          "default": "",
          "title": "Source Hash",
          "type": "string"
        },
        "extracted_at": {
          "default": "",
          "title": "Extracted At",
          "type": "string"
        },
        "extractor_version": {
          "default": "",
          "title": "Extractor Version",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "revision",
        "occurrence_path",
        "reference_id"
      ],
      "title": "CadSnapshotRow",
      "type": "object"
    },
    "SnapshotIssue": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Level",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "row_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "occurrence_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence Path"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        }
      },
      "required": [
        "level",
        "code",
        "message"
      ],
      "title": "SnapshotIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "rows": {
      "items": {
        "$ref": "#/$defs/CadSnapshotRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "source_path": {
      "title": "Source Path",
      "type": "string"
    },
    "source_hash": {
      "title": "Source Hash",
      "type": "string"
    },
    "extracted_at": {
      "title": "Extracted At",
      "type": "string"
    },
    "extractor_version": {
      "title": "Extractor Version",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/SnapshotIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "encoding": {
      "default": "",
      "title": "Encoding",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "rows",
    "source_path",
    "source_hash",
    "extracted_at",
    "extractor_version"
  ],
  "title": "CadSnapshot",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
