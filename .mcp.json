{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    },
    "muapi": {
      "type": "http",
      "url": "https://api.muapi.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${MUAPI_API_KEY}"
      }
    }
  }
}
