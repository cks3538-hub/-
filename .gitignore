# Local-only Playwright CLI workspace state (machine-specific browser path, session snapshots).
# Do not commit: .playwright/cli.config.json points at this sandbox's pre-installed Chromium
# (/opt/pw-browsers/chromium), which won't exist on other machines.
.playwright/
.playwright-cli/

# unlazy skill: local runtime/approval state and machine-specific hook settings
# (per .claude/skills/unlazy/SKILL.md - these are machine-specific, never shared)
.unlazy/
.unlazy-hook-state.json
.claude/settings.local.json
.claude/settings.local.json.unlazy.bak
.claude/settings.json.unlazy.bak

node_modules/
*.tmp

# graphify: generated knowledge-graph build output. Contains a machine-specific
# pinned interpreter path (.graphify_python, .graphify_root) and a local
# extraction cache/ dir - regenerate with `/graphify .` rather than committing.
graphify-out/
